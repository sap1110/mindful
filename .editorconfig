# Keeps whitespace consistent across editors, so a diff is never a tab war.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown gives meaning to a trailing double-space.
trim_trailing_whitespace = false
