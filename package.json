{
  "name": "mindful",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private mental-health and concussion-recovery companion that runs entirely in the browser — no backend, no account, no analytics, and no runtime network call, including for the AI.",
  "keywords": [
    "mental-health",
    "concussion",
    "privacy",
    "on-device-ai",
    "local-first",
    "transformers-js",
    "react",
    "vite",
    "accessibility"
  ],
  "license": "MIT",
  "author": "sap1110",
  "homepage": "https://github.com/sap1110/mindful#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sap1110/mindful.git"
  },
  "bugs": {
    "url": "https://github.com/sap1110/mindful/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "verify": "npm run lint && npm run build && npm run test",
    "train": "tsx src/lib/guide/training/train.ts",
    "build:evidence": "node scripts/build-evidence.mjs",
    "audit:crisis": "tsx scripts/audit-crisis-guard.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7"
  }
}
